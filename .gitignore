# Dependencies (Prevents uploading gigabytes of junk)
node_modules/
.pnp
.pnp.js

# Environment Variables (SECURITY CRITICAL - Never upload passwords!)
.env
.env.local
.env.*.local

# Build outputs
dist/
build/
.next/
out/

# Logs
npm-debug.log*
yarn-debug.log*
logs/

# OS Junk
.DS_Store
Thumbs.db
# Test coverage output
coverage/

# TypeScript build cache
*.tsbuildinfo

# Environment-specific env files (only .env.example is committed)
.env.production
.env.staging
.env.development

# Database backups (keep .gitkeep only)
backups/*.sql.gz


# D-13: scratch/backup artefacts belong in version control history, not the
# working tree. A corrupted component once hid in a .bak while the real file
# was broken (D-01). Note: this does not affect scripts/backup.sh or the
# backups/ directory used for database dumps.
*.bak
*.corrupt
_legacy_bak/
_*_backup/
