[Unit]
Description=Jocomfy platform health, disk, and container monitor
Documentation=file:///root/school-management-system/scripts/monitor.sh
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
OnFailure=jocomfy-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/root/school-management-system
ExecStart=/root/school-management-system/scripts/monitor.sh
UMask=0077
TimeoutStartSec=5m
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
