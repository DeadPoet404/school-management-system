# ── Demo (sms-demo.jocomfy.com) environment ─────────────────────────────
# Mirrors the staging/production compose conventions, but isolated, fake-data
# only, and capped lower. Copy to /etc/jocomfy-demo/demo.env and edit.

# --- Database (DEDICATED demo Supabase project — NEVER prod/staging) -------
# Transaction pooler (port 6543) for runtime.
DATABASE_URL=postgresql://postgres.<your-demo-ref>:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) — used ONLY by Prisma migrations and seeding.
DIRECT_URL=postgresql://postgres.<your-demo-ref>:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# --- Auth secrets (generate fresh; NEVER copy prod/staging values) ---------
JWT_SECRET=replace_with_a_long_random_demo_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_demo_secret
COOKIE_SECRET=replace_with_yet_another_long_random_demo_secret

# --- Runtime / security ----------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
PORT=5200
# Demo stays behind Cloudflare Access + the app login. Strict CORS to the demo
# origin only.
CORS_ORIGINS=https://sms-demo.jocomfy.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=10
# Public app URL, used in emails/links.
STAFF_PORTAL_URL=https://sms-demo.jocomfy.com
APP_URL=https://sms-demo.jocomfy.com
NEXT_PUBLIC_APP_ENV=demo

# --- Seed control (entrypoint honors these on `up`) -------------------------
# Seed ONLY the very first time against the empty demo DB. Leave RUN_SEED=false
# afterwards so restarts never touch the data. FORCE_SEED is intentionally a
# separate, explicit switch (also refuses non-empty unless FORCE_SEED=true).
RUN_SEED=false
FORCE_SEED=false

# ── Intentionally blank (demo must never send real mail/payments) ──────────
# validate-env.sh FAILS if any of these are non-empty in demo, exactly like
# staging. Real providers are only ever configured in production.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
GOOGLE_CLIENT_ID=
GMAIL_USER=
GMAIL_APP_PASSWORD=
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
