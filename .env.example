# ══════════════════════════════════════════════════════════════
# School Management System — Docker Compose Environment
# ══════════════════════════════════════════════════════════════
# 1. Copy this file:  cp .env.example .env
# 2. Fill in values below (especially the secrets)
# 3. Never commit .env to version control
#
# Generate secrets with:
#   openssl rand -hex 32
# ══════════════════════════════════════════════════════════════

# ── Database (Supabase Postgres) ──
# Get both URIs from: Supabase Dashboard → Project Settings → Database →
# Connection string. Replace YOUR_PROJECT_REF / YOUR_DB_PASSWORD / YOUR_REGION.
#   DATABASE_URL = "Transaction pooler" URI (port 6543) → runtime queries.
#                  Keep the ?pgbouncer=true&connection_limit=1 suffix.
#   DIRECT_URL   = "Direct connection" URI (port 5432) → ONLY for Prisma
#                  migrations and pg_dump backups (pooler cannot run DDL).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.supabase.com:5432/postgres

# ── JWT Signing Secrets ──
# MUST be at least 16 characters. MUST be different from each other.
# Compromise of one should not compromise the other.
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=change_me_different_secret_openssl_rand_hex_32

# ── Cookie Signing Secret ──
# Used by cookie-parser to cryptographically sign cookies.
COOKIE_SECRET=change_me_another_secret_openssl_rand_hex_32

# ── Cookie Configuration ──
# COOKIE_DOMAIN: Leave EMPTY for localhost. Only set for a real domain
#                e.g. COOKIE_DOMAIN=sms.school.edu.gh
#                Setting it to "localhost" breaks browsers (RFC 6265).
COOKIE_DOMAIN=

# COOKIE_SECURE: false = allow cookies over HTTP (local dev, Docker on localhost)
#                true  = require HTTPS (production only)
COOKIE_SECURE=false

# COOKIE_SAME_SITE: lax    = recommended for local dev and most production cases
#                   strict = maximum security, breaks some OAuth flows
#                   none   = required for cross-site embedding (needs Secure=true)
COOKIE_SAME_SITE=lax

# ── CORS ──
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Seeding ──
# Set to true on FIRST boot to create demo accounts and sample data.
# After first boot, set back to false — re-running seed deletes all data.
RUN_SEED=false

# ── Paystack Digital Collections (sandbox first) ──
# Obtain a test secret key from the Paystack test dashboard.
# Never expose this key to the browser or commit a real key.
PAYSTACK_SECRET_KEY=
PAYSTACK_API_BASE_URL=https://api.paystack.co

# ── API Documentation ──
# Set true only when API documentation should be available. In production, /api/docs requires ADMIN authentication.
ENABLE_API_DOCS=false

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ── Logging ──
LOG_LEVEL=info

# -- Google Sign-In for the External School Website (SMS-004) ---------------
# OAuth 2.0 Client ID (Google Cloud Console) for POST /api/auth/google.
# Leave blank until the website project issues credentials (endpoint -> 503).
GOOGLE_CLIENT_ID=
# Append the website's origin to CORS_ORIGINS above. For cross-site cookies use
# COOKIE_SAME_SITE=none + COOKIE_SECURE=true, or the Authorization: Bearer variant.
# PAYSTACK_CALLBACK_URL: where Paystack returns parents after checkout -- point
# it at the WEBSITE's payment-confirmation page (not the in-repo /portal).
PAYSTACK_CALLBACK_URL=

# -- Receipt Emails via Gmail SMTP (SMS-006) ------------------------------
# Passed through to the backend container (see sms-core-backend/.env.example
# for the 2FA + App Password setup). Leave blank to keep dispatch disabled.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# -- Class Timetable Calendar Feeds (SMS-010) ----------------------------
# Passed through to the backend. openssl rand -hex 32. Blank keeps feeds off.
CALENDAR_FEED_SECRET=

# -- Communication adapters (SMS-012; passed through to the backend) ---
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_BUSINESS_ACCOUNT_ID=

# ══════════════════════════════════════════════════════════════
# PRODUCTION SECTION — flip these when going live.
# Full runbook: PRODUCTION-CHECKLIST.md (do it top-to-bottom).
# ══════════════════════════════════════════════════════════════
# Generate every secret with:  openssl rand -hex 32
# The backend REFUSES to boot in production when:
#   - JWT_SECRET equals JWT_REFRESH_SECRET
#   - any of JWT/COOKIE secrets still starts with "change_me"
#   - a JWT secret is shorter than 32 characters
#
# 1) Replace the dev values set at the top of this file with fresh
#    64-char hex secrets (never reuse values that once lived in chat
#    logs, tickets, or screenshots).
#
# 2) When serving over HTTPS behind a reverse proxy, flip:
# COOKIE_SECURE=true
# COOKIE_DOMAIN=sms.school.edu.gh
# CORS_ORIGINS=https://sms.school.edu.gh
#
# 3) Never enable seeding on a production database:
# RUN_SEED=false
