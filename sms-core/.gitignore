# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# D-13: scratch/backup artefacts belong in version control history, not the
# working tree. A corrupted component once hid in a .bak while the real file
# was broken (D-01). Note: this does not affect scripts/backup.sh or the
# backups/ directory used for database dumps.
*.bak
*.corrupt
_legacy_bak/
_*_backup/
