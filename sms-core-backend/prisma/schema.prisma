datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: url points at the transaction pooler (port 6543) for runtime
  // queries. directUrl (port 5432) is used by the Prisma CLI only — the
  // pooler is pgbouncer-backed and cannot execute migrations' DDL.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ── STRICT TYPE ENUMERATIONS ──
enum EntityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DEPARTED
}

enum PayrollStatus {
  PENDING
  DISBURSED
}

enum DepartureType {
  GRADUATION
  TRANSFER
  VOLUNTARY_WITHDRAWAL
  EXPULSION
  OTHER
}

enum PersonnelDepartureType {
  RESIGNATION
  TERMINATION
  RETIREMENT
  CONTRACT_END
  OTHER
}

enum TreasuryClearanceStatus {
  FULLY_SETTLED
  OUTSTANDING_DEBT
  WRITTEN_OFF
  EXEMPT
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

/// Payment provider is intentionally an enum so each gateway adapter is
/// explicit and auditable. PAYSTACK is the first implementation.
enum PaymentProvider {
  PAYSTACK
}

/// Lifecycle is driven by verified provider evidence — never a browser claim.
enum PaymentIntentStatus {
  INITIALIZED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum ClearanceStatus {
  PENDING
  CLEARED
  DENIED
  NOT_APPLICABLE
  EXEMPT
}

enum ExpenseStatus {
  CLEARED
  PENDING_APPROVAL
  REJECTED
}

// ═══════════════════════════════════════════════════════════
// ── REFERENCE DATA TABLES ──
// ═══════════════════════════════════════════════════════════

model Class {
  id        String    @id @default(uuid())
  deletedAt DateTime?
  name      String    @unique
  /// Display/grouping letter or label only (e.g. "A"). NOT a foreign key.
  /// Canonical class identifier everywhere else is Class.id (UUID).
  section   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  placements   Placement[]
  gradeRecords GradeRecord[]

  // PR2 invariant: timetable/fee/collection "sectionId" columns store Class.id
  timetableConfigurations    TimetableConfiguration[]
  feeStructureConfigurations FeeStructureConfiguration[]
  paymentCollections         PaymentCollection[]
}

model Subject {
  id        String    @id @default(uuid())
  deletedAt DateTime?
  name      String    @unique
  code      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  teachers     Teacher[]    @relation("TeacherSubject")
  gradeRecords GradeRecord[]
}

model Term {
  id           String    @id @default(uuid())
  deletedAt    DateTime?
  name         String    @unique
  academicYear String
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  gradeRecords GradeRecord[]
}

model Department {
  id        String    @id @default(uuid())
  deletedAt DateTime?
  name      String    @unique
  code      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  teachers Teacher[] @relation("TeacherDepartment")
}

model FeeTier {
  id        String    @id @default(uuid())
  deletedAt DateTime?
  name      String    @unique
  code      String    @unique
  amount    Decimal   @db.Decimal(10, 2)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  billingLedgers BillingLedger[]
}

// ═══════════════════════════════════════════════════════════
// ── STUDENT MANAGEMENT SYSTEM ──
// ═══════════════════════════════════════════════════════════

model Student {
  id             String       @id @default(uuid())
  studentId      String       @unique
  studentName    String
  enrollmentDate DateTime
  status         EntityStatus @default(ACTIVE)
  currentGpa     Float        @default(0.0)
  attendanceRate Float        @default(100.0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  account      StudentAccount?
  demographics Demographics?
  placement    Placement?
  compliance   StudentCompliance?
  guardians    Guardian[]
  billing      BillingLedger?
  departures   StudentDeparture[]

  invoices          Invoice[]
  payments          Payment[]
  paymentIntents    PaymentIntent[]
  paymentLogs       PaymentCollection[]
  attendanceRecords AttendanceRecord[]
  grades            GradeRecord[]
}

model StudentAccount {
  id           String  @id @default(uuid())
  studentId    String  @unique
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  portalEmail  String  @unique
  passwordHash String
}

model Demographics {
  id                 String   @id @default(uuid())
  studentId          String   @unique
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dateOfBirth        DateTime
  gender             String
  residentialAddress String
  medicalNotes       String?  @db.Text
  bloodType          String?
  religion           String?
  formerSchool       String?
  nationalId         String?
}

model Placement {
  id             String  @id @default(uuid())
  studentId      String  @unique
  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String?
  class          Class?  @relation(fields: [classId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  academicTrack  String
  boardingStatus String
}

model StudentCompliance {
  id                String  @id @default(uuid())
  studentId         String  @unique
  student           Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  nationalId        String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
}

model Guardian {
  id           String  @id @default(uuid())
  studentId    String
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  email        String?

  @@index([studentId])
}

model BillingLedger {
  id             String  @id @default(uuid())
  studentId      String  @unique
  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeTierId      String?
  feeTier        FeeTier? @relation(fields: [feeTierId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  initialDeposit Decimal @default(0.0) @db.Decimal(10, 2)
  currentBalance Decimal @db.Decimal(10, 2)
}

model Invoice {
  id          String    @id @default(uuid())
  deletedAt   DateTime?
  invoiceNo   String    @unique
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal   @db.Decimal(10, 2)
  dueDate     DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ── ADD THESE TWO LINES ──
  paidAmount Decimal @default(0) @db.Decimal(10, 2)
  status   InvoiceStatus @default(UNPAID)
  configId String?

  @@index([studentId])
}

model Payment {
  id              String         @id @default(uuid())
  deletedAt       DateTime?
  receiptNo       String         @unique
  studentId       String
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentIntentId String?        @unique
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  description     String         @default("Fee Payment Clearance")
  amount          Decimal        @db.Decimal(10, 2)
  paymentType     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([studentId])
}

/// A server-created request for a digital payment. The amount, student,
/// currency, and reference are fixed here before Paystack is contacted.
model PaymentIntent {
  id                    String              @id @default(uuid())
  provider              PaymentProvider
  status                PaymentIntentStatus @default(INITIALIZED)
  studentId             String
  student               Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  amount                Decimal             @db.Decimal(10, 2)
  currency              String              @default("GHS") @db.VarChar(3)
  reference             String              @unique
  providerTransactionId String?             @unique
  authorizationUrl      String?
  accessCode            String?
  channel               String?
  metadata              Json?
  failureReason         String?             @db.Text
  expiresAt             DateTime?
  paidAt                DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  payment    Payment?
  collection PaymentCollection?

  @@index([studentId, status])
  @@index([status])
}

/// An immutable record of a provider callback. The provider/event key unique
/// constraint is the first idempotency barrier for duplicate webhooks.
model PaymentWebhookEvent {
  id              String          @id @default(uuid())
  provider        PaymentProvider
  eventType       String
  eventKey        String
  payload         Json
  receivedAt      DateTime        @default(now())
  processedAt     DateTime?
  processingError String?         @db.Text

  @@unique([provider, eventKey])
  @@index([eventType])
}

model StudentDeparture {
  id                      String                  @id @default(uuid())
  studentInternalId       String
  student                 Student                 @relation(fields: [studentInternalId], references: [id], onDelete: Cascade)
  departureType           DepartureType
  effectiveDate           DateTime
  destinationInstitution  String                  @default("N/A")
  treasuryClearanceStatus TreasuryClearanceStatus
  academicRecordsArchived Boolean                 @default(false)
  remarks                 String                  @db.Text
  processedAt             DateTime                @default(now())

  @@index([studentInternalId])
}

// ═══════════════════════════════════════════════════════════
// ── FACULTY & STAFF MANAGEMENT SYSTEM ──
// ═══════════════════════════════════════════════════════════

model Teacher {
  id                String       @id @default(uuid())
  teacherId         String       @unique
  teacherName       String
  department        String?
  departmentRecord  Department?  @relation("TeacherDepartment", fields: [department], references: [id], onDelete: SetNull, onUpdate: NoAction)
  subject           String?
  subjectRecord     Subject?     @relation("TeacherSubject", fields: [subject], references: [id], onDelete: SetNull, onUpdate: NoAction)
  status            EntityStatus @default(ACTIVE)
  employmentType    String
  email             String       @unique
  employmentDate    DateTime?
  yearsOfExperience Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // ── RELATIONAL UPGRADES (Now matches Staff depth) ──
  account      TeacherAccount?
  demographics TeacherDemographics?
  compliance   TeacherCompliance?
  payroll      TeacherPayroll?
  departures   TeacherDeparture[]
}

// ── Teacher Portal Account (resolves StaffAccount FK violation) ──
model TeacherAccount {
  id           String  @id @default(uuid())
  teacherId    String  @unique
  teacher      Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  email        String  @unique
  passwordHash String
  role         String  @default("FACULTY")
}

// ── NEW: Teacher Personal & Background Data ──
model TeacherDemographics {
  id                 String   @id @default(uuid())
  teacherId          String   @unique
  teacher            Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dateOfBirth        DateTime
  gender             String
  residentialAddress String
  phone              String
  bloodType          String?
  religion           String?
  formerSchool       String?
}

// ── NEW: Teacher Statutory & Emergency Data ──
model TeacherCompliance {
  id             String  @id @default(uuid())
  teacherId      String  @unique
  teacher        Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  nationalId     String?
  ssnitNumber    String?
  emergencyName  String?
  emergencyPhone String?
}

// ── NEW: Teacher Compensation & Disbursement Data ──
model TeacherPayroll {
  id            String        @id @default(uuid())
  teacherId     String        @unique
  teacher       Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  clearanceTier String
  baseSalary    Decimal       @default(0) @db.Decimal(10, 2)
  deductions    Decimal       @default(0) @db.Decimal(10, 2)
  netPay        Decimal       @default(0) @db.Decimal(10, 2)
  paymentRoute  String        @default("BANK_TRANSFER") // e.g., BANK_TRANSFER, MOBILE_MONEY
  bankName      String?
  bankAccount   String?
  salaryStatus  PayrollStatus @default(PENDING)
}

model TeacherDeparture {
  id                      String                 @id @default(uuid())
  teacherInternalId       String
  teacher                 Teacher                @relation(fields: [teacherInternalId], references: [id], onDelete: Cascade)
  departureType           PersonnelDepartureType
  effectiveDate           DateTime
  academicClearanceStatus ClearanceStatus
  treasuryClearanceStatus ClearanceStatus
  remarks                 String                 @db.Text
  processedAt             DateTime               @default(now())

  @@index([teacherInternalId])
}

model Staff {
  id              String       @id @default(uuid())
  staffId         String       @unique
  staffName       String
  appointmentDate DateTime
  status          EntityStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  account      StaffAccount?
  demographics StaffDemographics?
  placement    StaffPlacement?
  compliance   StaffCompliance?
  payroll      StaffPayroll?
  departures   StaffDeparture[]
}

model StaffDeparture {
  id                      String                 @id @default(uuid())
  staffInternalId         String
  staff                   Staff                  @relation(fields: [staffInternalId], references: [id], onDelete: Cascade)
  departureType           PersonnelDepartureType
  effectiveDate           DateTime
  hrClearanceStatus       ClearanceStatus
  itAssetReturnStatus     ClearanceStatus
  treasuryClearanceStatus ClearanceStatus
  remarks                 String                 @db.Text
  processedAt             DateTime               @default(now())

  @@index([staffInternalId])
}

model StaffAccount {
  id           String @id @default(uuid())
  staffId      String @unique
  staff        Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  email        String @unique
  passwordHash String
  role         String @default("STAFF")
}

model StaffDemographics {
  id                 String   @id @default(uuid())
  staffId            String   @unique
  staff              Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dateOfBirth        DateTime
  gender             String
  residentialAddress String
  phone              String
  bloodType          String?
  religion           String?
  formerSchool       String?
}

model StaffPlacement {
  id             String @id @default(uuid())
  staffId        String @unique
  staff          Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  departmentId   String
  jobTitle       String
  employmentType String
  shiftSchedule  String
}

model StaffCompliance {
  id             String  @id @default(uuid())
  staffId        String  @unique
  staff          Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  nationalId     String?
  ssnitNumber    String?
  emergencyName  String?
  emergencyPhone String?
}

model StaffPayroll {
  id            String        @id @default(uuid())
  staffId       String        @unique
  staff         Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  clearanceTier String
  baseSalary    Decimal       @default(0) @db.Decimal(10, 2)
  deductions    Decimal       @default(0) @db.Decimal(10, 2)
  netPay        Decimal       @default(0) @db.Decimal(10, 2)
  paymentRoute  String        @default("BANK_TRANSFER")
  bankName      String?
  bankAccount   String?
  salaryStatus  PayrollStatus @default(PENDING)
}

// ═══════════════════════════════════════════════════════════
// ── TIMETABLE CONFIGURATION DOMAIN ──
// ═══════════════════════════════════════════════════════════

model TimetableConfiguration {
  id           String   @id @default(uuid())
  /// Canonical class key: MUST equal Class.id (not Class.section / not jhs-1 tokens).
  sectionId    String   @unique
  class        Class    @relation(fields: [sectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  periodsCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  periods  TimetablePeriod[]
  breaks   TimetableBreak[]
  subjects SubjectAllocation[]
}

model TimetablePeriod {
  id              String                 @id @default(uuid())
  configurationId String
  configuration   TimetableConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  periodNumber    Int
  dayOfWeek       String?
  startTime       String
  endTime         String

  @@unique([configurationId, periodNumber, dayOfWeek])
}

model TimetableBreak {
  id              String                 @id @default(uuid())
  configurationId String
  configuration   TimetableConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  name            String
  dayOfWeek       String?
  startTime       String
  endTime         String
}

model SubjectAllocation {
  id              String                 @id @default(uuid())
  configurationId String
  configuration   TimetableConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  subjectName     String
  teacherId       String
  dayOfWeek       String?
}

// ═══════════════════════════════════════════════════════════
// ── INSTITUTIONAL FINANCE & ACCOUNTING ENGINE ──
// ═══════════════════════════════════════════════════════════

model FeeStructureConfiguration {
  id                String    @id @default(uuid())
  deletedAt         DateTime?
  /// Canonical class key: MUST equal Class.id (not Class.section / not jhs-1 tokens).
  sectionId         String    @unique
  class             Class     @relation(fields: [sectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  issueDate         DateTime
  dueDate           DateTime
  allowInstallments Boolean   @default(true)
  lateFeeRate       Decimal   @default(0) @db.Decimal(5, 2)

  components FeeComponent[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model FeeComponent {
  id          String    @id @default(uuid())
  deletedAt   DateTime?
  configId    String
  name        String
  amount      Decimal   @db.Decimal(10, 2)
  frequency   String
  isMandatory Boolean   @default(true)

  configuration FeeStructureConfiguration @relation(fields: [configId], references: [id], onDelete: Cascade)
}

model PaymentCollection {
  id               String    @id @default(uuid())
  deletedAt        DateTime?
  receiptNumber    String    @unique
  /// Canonical class key: MUST equal Class.id (not Class.section / not jhs-1 tokens).
  sectionId        String
  class            Class     @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  studentName      String
  amountPaid       Decimal   @db.Decimal(10, 2)
  paymentMethod    String
  referenceNo      String    @default("N/A (Direct)")
  allocationTarget String
  dateProcessed    DateTime  @default(now())

  // ── NEW: SMART PAYMENT ROUTING ──
  studentInternalId String?
  student           Student?        @relation(fields: [studentInternalId], references: [id], onDelete: SetNull)
  paymentIntentId   String?         @unique
  paymentIntent     PaymentIntent?  @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@index([sectionId])
  @@index([studentInternalId])
}

model LedgerAccount {
  code        String    @id
  deletedAt   DateTime?
  accountName String
  category    String
  debit       Decimal   @default(0.0) @db.Decimal(10, 2)
  credit      Decimal   @default(0.0) @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("ledger_accounts")
}

model Expense {
  id            String        @id @default(uuid())
  deletedAt     DateTime?
  expenseNo     String        @unique
  vendorName    String
  category      String
  description   String        @db.Text
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod String
  status        ExpenseStatus @default(PENDING_APPROVAL)
  expenseDate   DateTime      @default(now())
  processedBy   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([expenseDate])
}

/// ==========================================
// UPDATED: ATTENDANCE DOMAIN SCHEMAS (Fixed Type Mismatches)
// ==========================================
model AttendanceRecord {
  id        String           @id @default(uuid())
  studentId String
  date      DateTime         @db.Date
  status    AttendanceStatus
  remarks   String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId, status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// ==========================================
// UPDATED: ACADEMIC GRADES SCHEMAS (Fixed Type Mismatches)
// ==========================================
model GradeRecord {
  id                   String   @id @default(uuid())
  studentId            String
  subjectId            String
  classId              String
  termId               String
  continuousAssessment Decimal  @db.Decimal(5, 2)
  examination          Decimal  @db.Decimal(5, 2)
  finalScore           Decimal  @db.Decimal(5, 2)
  letterGrade          String   @db.VarChar(2)
  gradePoints          Decimal  @db.Decimal(3, 2)
  creditHours          Int      @default(3)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([studentId, subjectId, termId], name: "studentId_subjectId_termId")
  @@index([studentId, termId])
}

// ═══════════════════════════════════════════════════════════
// ── AUDIT TRAIL ──
// ═══════════════════════════════════════════════════════════

model AuditLog {
  id             String   @id @default(cuid())
  requestId      String
  actorId        String
  actorEmail     String
  actorRole      String
  action         String
  method         String
  path           String
  requestBody    Json?
  responseStatus Int
  ipAddress      String
  createdAt      DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── P1: Refresh Token Storage ──
// Access tokens are stateless (JWT verify only).
// Refresh tokens are stateful (DB-backed) to support
// rotation, revocation, and forced logout.
model RefreshToken {
  id          String    @id @default(uuid())
  token       String    @unique
  accountId   String    // StudentAccount.id | StaffAccount.id | TeacherAccount.id
  accountType String    // 'STUDENT' | 'STAFF' | 'TEACHER'
  userId      String    // Student.id | Staff.id | Teacher.id (for downstream queries)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime? // Non-null = token has been explicitly revoked

  @@index([token])
  @@index([accountId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ══════════════════════════════════════════════════════════════════════
// SMS-012 ── COMMUNICATION (announcements + durable delivery ledger)
// ══════════════════════════════════════════════════════════════════════

model Announcement {
  id             String   @id @default(uuid())
  title          String
  body           String   @db.Text
  /// SCHOOL_WIDE | CLASS | STUDENTS
  audience       String
  /// Required when audience = CLASS (canonical Class.id).
  classId        String?
  /// Internal Student.id list when audience = STUDENTS (Json string[]).
  studentIds     Json?
  /// Requested channels: Json string[] subset of SMS | WHATSAPP | EMAIL.
  channels       Json
  /// QUEUED -> SENDING -> COMPLETED (per-delivery FAILED rows stay visible).
  status         String   @default("QUEUED")
  createdBy      String
  createdByEmail String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deliveries NotificationDelivery[]

  @@index([audience, createdAt])
}

model NotificationDelivery {
  id                String       @id @default(uuid())
  announcementId    String
  announcement      Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  /// SMS | WHATSAPP | EMAIL
  channel           String
  /// Phone number (SMS / WHATSAPP) or email address (EMAIL).
  recipient         String
  recipientLabel    String?
  /// Resolution-context student (null when not attributable to one).
  studentId         String?
  /// QUEUED | SENT | FAILED
  status            String       @default("QUEUED")
  attempts          Int          @default(0)
  nextAttemptAt     DateTime     @default(now())
  providerMessageId String?
  error             String?      @db.Text
  sentAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status, nextAttemptAt])
  @@index([announcementId])
}
