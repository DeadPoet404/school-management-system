# ──────────────────────────────────────────────
# SMS Core Backend — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Generate secrets: openssl rand -hex 32
# NEVER commit .env to version control.
#

# ── Application ──
NODE_ENV=development
PORT=5000

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://sms_user:your_password@localhost:5432/sms_db?schema=public

# ── Authentication (JWT) ──
# Both secrets MUST be at least 16 characters and MUST differ from each other.
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_different_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cookie Configuration ──
# Leave COOKIE_DOMAIN empty for localhost development.
# Set to your real domain only in production with HTTPS.
COOKIE_SECRET=replace_with_openssl_rand_hex_32
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ── Logging ──
LOG_LEVEL=info

# ── Paystack Digital Collections (sandbox first) ──
# Keep blank until you obtain a Paystack TEST secret key.
# This value is server-only; never use NEXT_PUBLIC_ for it.
PAYSTACK_SECRET_KEY=
PAYSTACK_API_BASE_URL=https://api.paystack.co

# ── API Documentation ──
# Set true to serve /api/docs locally. Non-development environments also require ADMIN authentication.
ENABLE_API_DOCS=true

# Callback URL the portal opens after a Paystack checkout. Replace port if your frontend differs.
PAYSTACK_CALLBACK_URL=http://localhost:3000/portal/payments/status

# -- Google Sign-In for the External School Website (SMS-004) ---------------
# OAuth 2.0 Client ID (Google Cloud Console) used to verify the ID tokens the
# website exchanges at POST /api/auth/google. Leave blank to keep the endpoint
# disabled (it answers 503 until configured).
GOOGLE_CLIENT_ID=
# Append the website's origin to CORS_ORIGINS, e.g.
# CORS_ORIGINS=http://localhost:3000,https://portal.yourschool.edu.gh
# If the website is a DIFFERENT site, either set COOKIE_SAME_SITE=none with
# COOKIE_SECURE=true (HTTPS required) for cross-site cookies, or have the
# website use the tokens returned in the JSON body via Authorization: Bearer
# (see docs/PORTAL_API.md).

# -- Receipt Emails via Gmail SMTP (SMS-006) ------------------------------
# Nodemailer transport for receipts on cash collection and Paystack
# reconciliation. Requires a Gmail account with 2-Step Verification ON,
# then an App Password (Google Account -> Security -> App passwords).
# Leave blank to keep dispatch disabled (sends are skipped and logged).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# -- Class Timetable Calendar Feeds (SMS-010) ----------------------------
# HMAC secret signing the .ics subscription tokens. Generate with
#   openssl rand -hex 32
# Leave blank to keep feeds disabled (503). Rotate to invalidate all links.
CALENDAR_FEED_SECRET=

# -- Communication adapters (SMS-012) -------------------------------
# Leave any blank to keep that channel disabled (deliveries then fail
# permanently with error 'channel-disabled' -- ledger tells the truth).
# SMS via Arkesel (Ghana-local). Sender id max 11 chars, must be approved.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
# WhatsApp via Meta Cloud API -- requires Meta business verification +
# template approval; adapter stays dark until all three are set.
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_BUSINESS_ACCOUNT_ID=
